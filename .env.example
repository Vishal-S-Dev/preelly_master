PREELLY_API_BASE_URL_DEV=https://beta.preelly.xyz
PREELLY_API_BASE_URL_PROD=https://beta.preelly.xyz

# DEV ONLY — temporary CCAvenue test credentials (never commit real values).
# Prefer setting these on the backend server as CCA_MERCHANT_ID / CCA_ACCESS_CODE / CCA_WORKING_KEY.
# App sends them in /api/payment/initiate body only when __DEV__ and CCA_DEV_FALLBACK_ENABLED=true.
CCA_DEV_FALLBACK_ENABLED=true
CCA_MERCHANT_ID=
CCA_ACCESS_CODE=
CCA_WORKING_KEY=

# Google Maps SDK (Android + iOS). Required for address / location map tiles.
# Rebuild native apps after changing this value.
# Enable in Google Cloud: Maps SDK for Android, Maps SDK for iOS, Maps Static API.
# Restrict Android by package + SHA-1; restrict iOS by bundle id.
GOOGLE_MAPS_API_KEY=


