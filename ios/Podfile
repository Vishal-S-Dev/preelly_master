def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

# @react-native-firebase/* resolves Firebase via Swift Package Manager by default, which
# collides at link time under this project's static pod linkage (no use_frameworks! is set).
# Opt out of SPM so Firebase resolves through classic CocoaPods instead — avoids switching the
# whole project to dynamic frameworks just for this.
$RNFirebaseDisableSPM = true

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Required for Firebase's Swift pods (FirebaseCoreInternal -> GoogleUtilities) to build as static
# libraries — standard requirement for any CocoaPods-based Firebase iOS integration that doesn't
# use `use_frameworks!`.
use_modular_headers!

setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
  'LocationWhenInUse',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Preelly' do
  config = use_native_modules!

  # Google Maps on iOS (autolinking disabled in react-native.config.js to avoid
  # installing the default Apple-only Maps subspec alongside Google).
  # Fabric components are registered manually via PreellyDependencyProvider.
  pod 'react-native-maps',
      :path => '../node_modules/react-native-maps',
      :subspecs => ['Google']

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # `use_modular_headers!` (added above for Firebase's Swift pods) makes several
    # Firebase/GoogleSignIn targets modular; those targets include some non-modular headers
    # internally, which Xcode otherwise treats as a hard build error
    # (CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES defaults to NO). Standard fix for
    # this well-documented Firebase+CocoaPods conflict.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # React-jsitooling and React-RuntimeCore both set `header_dir = "react/runtime"`
    # (upstream react-native podspec bug — their `module_name:` overrides only apply under
    # `use_frameworks!`), so under static linkage + `use_modular_headers!` CocoaPods derives the
    # same Clang module name ("react_runtime") for both, and any target that pulls in both
    # (e.g. React-RuntimeHermes when building RN core from source via RCT_USE_PREBUILT_RNCORE=0)
    # fails with "Redefinition of module 'react_runtime'". React-jsitooling's headers are plain
    # C++ (`#include`d, never `@import`ed), so disabling its module generation is safe and
    # resolves the collision without needing use_frameworks!.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'React-jsitooling'
      target.build_configurations.each do |config|
        config.build_settings['DEFINES_MODULE'] = 'NO'
      end
    end
  end
end
